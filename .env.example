GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VITE_API_BASE=http://localhost:7860
VITE_MCP_URL=http://localhost:7860/mcp
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7860
# Comma-separated exact MCP Host values to lock down (enables DNS protection).
# Leave empty for open demo mode (works on any HF hostname).
MCP_ALLOWED_HOSTS=
SPACE_HOST=
# --- production hardening (all optional, demo-safe defaults shown) ---
# APP_ENV=production hides /docs + /openapi.json and tightens checks.
APP_ENV=development
# Comma-separated Host header allowlist (default * = open demo mode).
TRUSTED_HOSTS=*
# RevenueCat webhook bearer secret. Unset = webhook runs in TEST MODE.
RC_WEBHOOK_AUTH=
# Max request body bytes (biggest legit call is a ~200KB blob + envelope).
MAX_BODY_BYTES=1048576
# Relay abuse budget + kill-switch for load tests.
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_ENABLED=true
KAVACH_SENIOR_ID=demo-senior
MAX_INPUT_CHARS=8000
DB_PATH=./kavach.db
LOG_LEVEL=info
APP_VERSION=0.1.0
